# Your FSolar / Shine Felicity Solar account credentials
# For local testing, copy this file to .env and run: npm run sync
# For GitHub Pages hosting, add these as GitHub Repository Secrets!
FSOLAR_EMAIL=your-fsolar-email@example.com
FSOLAR_PASSWORD=your-fsolar-password

# Optional: Battery bank capacity in Ah at 24V (default: 200Ah = 4.8kWh / 5.12kWh LiFePO4)
BATTERY_CAPACITY_AH=200
BATTERY_NOMINAL_VOLTAGE=25.6

# Optional: Your IANA timezone for accurate daily rollups (e.g. Asia/Baghdad, Africa/Cairo, Asia/Beirut, UTC)
SOLAR_TIMEZONE=UTC
